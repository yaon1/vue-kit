{
  "name": "@yaon1/vue-kit",
  "version": "0.2.0",
  "description": "Accessible, themeable Vue 3 components: Combobox, DataTable, Toast",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-kit.js"
    },
    "./style.css": "./dist/vue-kit.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "size": "node -e \"const z=require('zlib'),f=require('fs');for(const p of ['dist/vue-kit.js','dist/vue-kit.css']){const b=f.readFileSync(p);console.log(p,(z.gzipSync(b).length/1024).toFixed(2)+' kB gzip')}\""
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaon1/vue-kit.git"
  },
  "homepage": "https://yaon1.github.io/vue-kit/",
  "bugs": {
    "url": "https://github.com/yaon1/vue-kit/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "accessibility",
    "a11y",
    "combobox",
    "datatable",
    "virtual-scroll",
    "toast"
  ]
}
